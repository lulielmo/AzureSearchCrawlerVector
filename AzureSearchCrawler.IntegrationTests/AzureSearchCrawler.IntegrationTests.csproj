<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <TestingPlatformCommandLineArguments>--coverage --coverage-output-format cobertura --coverage-output $(MSBuildProjectDirectory)\TestResults\coverage.cobertura.xml</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ReportGenerator" Version="5.5.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AzureSearchCrawler.TestUtilities\AzureSearchCrawler.TestUtilities.csproj" />
    <ProjectReference Include="..\AzureSearchCrawler\AzureSearchCrawler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\AzureSearchCrawler.Tests\CoverageHtmlReport.cs" Link="CoverageHtmlReport.cs" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="TestResults\CoverageReport\" />
  </ItemGroup>

  <Target Name="WriteCoverageReportSettings" AfterTargets="Build">
    <MakeDir Directories="$(MSBuildProjectDirectory)\TestResults" />
    <WriteLinesToFile
      File="$(TargetDir)coverage-report.settings"
      Lines="$(MSBuildProjectDirectory)|$(PkgReportGenerator)\tools\net10.0\ReportGenerator.dll"
      Overwrite="true" />
  </Target>

  <Target Name="GenerateHtmlCoverageReport" AfterTargets="InvokeTestingPlatform">
    <ItemGroup>
      <CoverageReport Include="TestResults/**/*.cobertura.xml" />
    </ItemGroup>
    <Copy SourceFiles="@(CoverageReport)" DestinationFiles="TestResults/coverage.cobertura.xml" Condition="'@(CoverageReport)' != '' And !Exists('TestResults/coverage.cobertura.xml')" />
    <ReportGenerator ReportFiles="TestResults/coverage.cobertura.xml" TargetDirectory="TestResults/CoverageReport" ReportTypes="Html" Condition="Exists('TestResults/coverage.cobertura.xml')" />
  </Target>

</Project>
